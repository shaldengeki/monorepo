load("@py_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/build_rules/worker:defs.bzl", "worker")

py_library(
    name = "library",
    srcs = glob(["**/*.py"]),
    visibility = ["//mc_manager/worker:__subpackages__"],
    deps = [
        "//scripts:wait_for_postgres",
        requirement("boto3"),
        requirement("docker"),
        requirement("requests"),
    ],
)

worker(
    name = "worker",
    env = {
        "API_HOST": "api",
        "API_PORT": "5000",
        "AWS_ACCESS_KEY_ID": "",
        "AWS_SECRET_ACCESS_KEY": "",
        "HOST_PATH": "/var/minecraft",
        "S3_BUCKET": "",
    },
    registry = "docker.io",
    repository = "shaldengeki/mc-manager-worker",
    tag = "latest",
    deps = [
        "@py_deps//boto3",
        "@py_deps//docker",
        "@py_deps//requests",
    ],
)

py_binary(
    name = "app",
    srcs = ["app.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@py_deps//boto3",
        "@py_deps//docker",
        "@py_deps//requests",
    ],
)

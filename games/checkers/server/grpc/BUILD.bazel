load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "grpc",
    srcs = ["grpc.go"],
    importpath = "github.com/shaldengeki/monorepo/games/checkers/server/grpc",
    visibility = ["//visibility:public"],
    deps = [
        "//games/checkers/game_state",
        "//games/checkers/proto/server:server_go_proto",
        "//games/checkers/rule_set",
    ],
)

go_test(
    name = "grpc_test",
    size = "small",
    srcs = ["grpc_test.go"],
    embed = [":grpc"],
    deps = [
        "//games/checkers/game_state/empty_game_state",
        "//games/checkers/game_state/in_memory_game_state",
        "//games/checkers/game_state/read_only_in_memory_game_state",
        "//games/checkers/game_state/static_game_state",
        "//games/checkers/proto:proto_go_proto",
        "//games/checkers/proto/server:server_go_proto",
        "//games/checkers/rule_set/default_rule_set",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

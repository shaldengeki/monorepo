load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/build_rules/api:defs.bzl", "grpc_api_image")

go_library(
    name = "main_lib",
    srcs = ["main.go"],
    importpath = "github.com/shaldengeki/monorepo/games/tictactoe/server/main",
    visibility = ["//visibility:private"],
    deps = [
        "//games/tictactoe/game_state/in_memory_game_state",
        "//games/tictactoe/proto/server:server_go_proto",
        "//games/tictactoe/rule_set/default_rule_set",
        "//games/tictactoe/server/grpc",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "main",
    embed = [":main_lib"],
    visibility = ["//visibility:public"],
)

grpc_api_image(
    name = "image",
    binary = "//games/tictactoe/server/main:main",
    registry = "docker.io",
    repository = "shaldengeki/tictactoe-server",
    tag = "latest",
)

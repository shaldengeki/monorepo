# Import Aspect bazelrc presets

try-import %workspace%/aspect.bazelrc

test --test_output=errors

# passes an argument `--skipLibCheck` to *every* spawn of tsc
# Bazel 6.4 or greater: 'common' means 'any command that supports this flag'
common --@aspect_rules_ts//ts:skipLibCheck=always

# Use protoc toolchain, to avoid recompiling protoc.
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc=true
common --incompatible_enable_proto_toolchain_resolution

# Break protoc compilation deliberately.
# This no longer works with @protobuf; see https://github.com/protocolbuffers/protobuf/issues/25453
# common --per_file_copt=external/.*protobuf.*@--PROTOBUF_WAS_NOT_SUPPOSED_TO_BE_BUILT
# common --host_per_file_copt=external/.*protobuf.*@--PROTOBUF_WAS_NOT_SUPPOSED_TO_BE_BUILT
# common --per_file_copt=external/.*grpc.*@--GRPC_WAS_NOT_SUPPOSED_TO_BE_BUILT
# common --host_per_file_copt=external/.*grpc.*@--GRPC_WAS_NOT_SUPPOSED_TO_BE_BUILT

# boost.asio & mysql have a dependency on an SSL implementation.
# we have to explicitly tell them to use boringssl.
build --@boost.asio//:ssl=boringssl
build --@boost.mysql//:ssl=boringssl

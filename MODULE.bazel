#### Protoc
register_toolchains("//tools/protoc:all")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(
    sha256 = "4b068cfcff9168d713fe67ed6e3b715093e0f08ccaccea962169e7cd9d1726b1",
    version = "v1.68.4",
)
